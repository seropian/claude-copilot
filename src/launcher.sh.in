#!/usr/bin/env bash
# claude-copilot: run Claude Code on GitHub Copilot models. See README.md.

_cc_version="__CLAUDE_COPILOT_VERSION__"
_cc_update_state=""

# Prerequisites: python3 (3.6+), curl, claude. Prints what is missing and how to get it.
_cc_check() {
  local c missing=""
  for c in python3 curl claude; do
    command -v "$c" >/dev/null 2>&1 || missing="$missing $c"
  done
  if [ -n "$missing" ]; then
    echo "claude-copilot: missing required tools:$missing" >&2
    case "$missing" in *python3*) echo "  python3: https://www.python.org/downloads/ (macOS: brew install python)" >&2 ;; esac
    case "$missing" in *curl*) echo "  curl: use your package manager (brew install curl, apt install curl)" >&2 ;; esac
    case "$missing" in *claude*) echo "  claude (Claude Code): https://code.claude.com/docs/en/setup" >&2 ;; esac
    return 1
  fi
  if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 6))' 2>/dev/null; then
    echo "claude-copilot: python3 3.6 or newer is required (found $(python3 --version 2>&1))" >&2
    return 1
  fi
}

# Return a stable process-start token. This prevents a reused pid from owning an old lease.
_cc_start_token() {
  ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ *//;s/ *$//'
}

# Remove dead or pid-reused client leases. Call while holding shim.lock.
_cc_lease_reap() {
  local d="$1" f p want got
  [ -d "$d" ] || return 0
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    p="${f##*/}"
    case "$p" in ''|*[!0-9]*) rm -f "$f"; continue ;; esac
    want=$(cat "$f" 2>/dev/null) || want=""
    got=$(_cc_start_token "$p")
    kill -0 "$p" 2>/dev/null || got=""
    [ -n "$want" ] && [ "$want" = "$got" ] || rm -f "$f"
  done
}

_cc_lease_add() {
  local d="$1" p="$$" token spare="${2:-0}"
  token=$(_cc_start_token "$p")
  [ -n "$token" ] || return 1
  if [ "$spare" = 1 ]; then
    ( umask 077; mkdir -p "$d/../spares" && printf '%s\n' "$token" > "$d/../spares/$p" ) || return 1
  fi
  ( umask 077; mkdir -p "$d" && printf '%s\n' "$token" > "$d/$p.tmp" && mv -f "$d/$p.tmp" "$d/$p" )
  _cc_lease_file="$d/$p"
}

_cc_lease_release() {
  if [ -n "${_cc_lease_file:-}" ]; then
    rm -f "$_cc_lease_file" "${_cc_lease_file%/*}/../spares/${_cc_lease_file##*/}"
  fi
  _cc_lease_file=""
}

_cc_lease_any() {
  local d="$1" f
  [ -d "$d" ] || return 1
  for f in "$d"/*; do [ -f "$f" ] && return 0; done
  return 1
}

# Release this launcher and stop an unowned shim. Call after the shim has started.
_cc_release() {
  local d="$1" f p oport okey
  [ -n "${_cc_lease_file:-}" ] || return 0
  local took=0
  if [ "${_cc_lock:-}" != "$d/shim.lock" ]; then
    _cc_lock_take "$d/shim.lock" || return 0
    took=1
  fi
  # Leave an unleased shim alive for the idle grace period. This avoids
  # restarting it when a session is briefly detached or relaunched.
  _cc_lease_release
  _cc_lease_reap "$d/leases"
  [ "$took" = 1 ] && _cc_lock_drop
}

# args: shim pid, port file. Kills our half-started shim and releases our lease.
# No pid yet (we were interrupted before the shim wrote its port file)? Use the early pid file.
_cc_cleanup() {
  local p="$1"
  [ -z "$p" ] && [ -n "$2" ] && [ -f "$2.pid" ] && p=$(cat "$2.pid" 2>/dev/null)
  case "$p" in ''|*[!0-9]*) ;; *) kill "$p" 2>/dev/null ;; esac
  [ -n "$2" ] && rm -f "$2" "$2.pid" "$2.tmp"
  _cc_release "${_cc_state_dir:-${COPILOT_STATE_DIR:-$HOME/.local/share/claude-copilot}}"
  _cc_lock_drop
  return 0
}

# mkdir lock so concurrent launchers never start two shims. Stale if its owner pid is dead.
_cc_lock=""
_cc_lock_ownerless() {
  python3 -c 'import os, sys, time
try:
    old = time.time() - os.stat(sys.argv[1]).st_mtime >= 5
    if old: os.rmdir(sys.argv[1])
except (FileNotFoundError, OSError):
    pass' "$1"
}
_cc_lock_take() {
  local d="$1" i p
  for i in $(seq 1 200); do
    if mkdir "$d" 2>/dev/null; then
      if echo $$ > "$d/pid"; then _cc_lock="$d"; return 0; fi
      rmdir "$d" 2>/dev/null
      return 1
    fi
    _cc_lock_break "$d"
    sleep 0.1
  done
  return 1
}
# Remove a lock whose owner died. Serialized through "$d.break" and re-checked inside it, so a waiter that saw
# the dead owner earlier can't delete the lock another waiter just took.
_cc_lock_break() {
  local d="$1" b="$1.break" p
  if ! mkdir "$b" 2>/dev/null; then
    p=$(cat "$b/pid" 2>/dev/null)
    case "$p" in '') _cc_lock_ownerless "$b" ;; *[!0-9]*) ;; *) kill -0 "$p" 2>/dev/null || rm -rf "$b" ;; esac
    return 0
  fi
  echo $$ > "$b/pid"
  p=$(cat "$d/pid" 2>/dev/null)
  case "$p" in '') _cc_lock_ownerless "$d" ;; *[!0-9]*) ;; *) kill -0 "$p" 2>/dev/null || rm -rf "$d" ;; esac
  rm -rf "$b"
}
_cc_lock_drop() {
  [ -n "$_cc_lock" ] && rm -rf "$_cc_lock"
  _cc_lock=""
}

# dynamic scope: reads wrap, model, sa from claude-copilot
_cc_run() {
  local -a env_args=(env -u ANTHROPIC_MODEL) cmd
  [ -n "$model" ] && env_args+=(ANTHROPIC_MODEL="$model")
  if [ "$wrap" = 1 ]; then
    cmd=("$@")
  else
    cmd=(claude)
    [ -n "$model" ] && cmd+=(--model "$model")
    cmd+=(${sa[@]+"${sa[@]}"} "$@")
  fi
  if [ "$spare" = 1 ]; then
    "${env_args[@]}" python3 -c "$shim" spare "$sdir" "${cmd[@]}"
  else
    "${env_args[@]}" "${cmd[@]}"
  fi
}

_cc_port_busy() {
  python3 -c 'import socket, sys; sys.exit(0 if socket.socket().connect_ex(("127.0.0.1", int(sys.argv[1]))) == 0 else 1)' "$1"
}

# args: port, key. True if one of our shims answers on that port with that key.
_cc_shim_ok() {
  [ "$(printf 'header = "x-api-key: %s"\n' "$2" | curl -s -m 3 -K - -o /dev/null -w '%{http_code}' "http://127.0.0.1:$1/nope" 2>/dev/null)" = 404 ]
}

_cc_picker_ready() {
  python3 -c 'import json, os, stat, sys
try:
    if os.path.islink(sys.argv[1]): raise ValueError("cache is a symlink")
    if not stat.S_ISREG(os.stat(sys.argv[1]).st_mode): raise ValueError("cache is not a regular file")
    with open(sys.argv[1]) as f: s = json.load(f)
    picker = s.get("modelPicker") if isinstance(s, dict) else None
    options = picker.get("options") if isinstance(picker, dict) else None
    if not isinstance(options, list) or not options or not all(
        isinstance(o, dict) and isinstance(o.get("model"), str) and o["model"]
        and isinstance(o.get("label"), str) for o in options):
        raise ValueError("cache does not contain a complete model picker")
except FileNotFoundError:
    sys.exit(1)
except (OSError, ValueError) as e:
    print("claude-copilot: invalid model picker cache: %s" % e, file=sys.stderr)
    sys.exit(1)' "$1"
}

_cc_refresh_picker() {
  local d="$1" port="$2" key="$3" timeout="$4"
  (
    local tmp
    if [ -L "$d/model-picker.json" ]; then
      echo "claude-copilot: model picker refresh refused: cache is a symlink" >&2
      exit 1
    fi
    tmp=$(umask 077; mktemp "$d/model-picker.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' EXIT
    if ! printf 'header = "x-api-key: %s"\n' "$key" |
      curl -sf --connect-timeout 0.5 -m "$timeout" -K - "http://127.0.0.1:$port/claude-settings" -o "$tmp"; then
      echo "claude-copilot: model picker refresh failed; keeping cached models" >&2
      exit 1
    fi
    _cc_picker_ready "$tmp" || exit 1
    python3 -c 'import json, os, sys
with open(sys.argv[1]) as f: s = json.load(f)
with open(sys.argv[1], "w") as f: json.dump({"modelPicker": s["modelPicker"]}, f)
os.replace(sys.argv[1], sys.argv[2])' "$tmp" "$d/model-picker.json"
  )
}

# Warm launches use the last complete catalog while the next snapshot is fetched.
_cc_start_picker_refresh() {
  ( trap '' HUP INT; _cc_refresh_picker "$1" "$2" "$3" 35 ) </dev/null >>"$4" 2>&1 &
}

_cc_fail() {
  [ -n "$_cc_update_state" ] && rm -f "$_cc_update_state"
  _cc_lock_drop
  trap - HUP TERM INT
  return 1
}

# arg: file holding the last version that ran. Says so once when the version changed since then.
_cc_announce_update() {
  local f="$1" old=""
  if [ -L "$f" ]; then _cc_previous_version="unknown"; return 0; fi
  [ -f "$f" ] && read -r old < "$f" 2>/dev/null
  _cc_previous_version="$old"
  [ "$old" = "$_cc_version" ] && return 0
  [ -n "$old" ] && echo "claude-copilot: updated $old -> $_cc_version" >&2
  ( umask 077; printf '%s\n' "$_cc_version" > "$f.tmp" && mv -f "$f.tmp" "$f" ) 2>/dev/null
  return 0
}

# args: state dir, shim state version, previous launcher version. True when legacy cleanup has nothing to do.
_cc_legacy_cleanup_current() {
  local marker="$1/legacy-cleanup-version" old=""
  [ -L "$marker" ] && return 1
  [ -f "$marker" ] && read -r old < "$marker" 2>/dev/null
  [ "$old" = "$_cc_version" ] && [ "$2" = "$_cc_version" ] && { [ -z "$3" ] || [ "$3" = "$_cc_version" ]; }
}

_cc_legacy_cleanup() {
  local d="$1" script="$2" state_version="$3" previous="$4"
  local marker="$1/legacy-cleanup-version"
  _cc_legacy_cleanup_deferred=0
  if [ -L "$marker" ]; then
    echo "claude-copilot: legacy cleanup deferred: cleanup marker is a symlink" >&2
    _cc_legacy_cleanup_deferred=1
    return 1
  fi
  _cc_legacy_cleanup_current "$d" "$state_version" "$previous" && return 0
  if [ -z "$previous" ] && [ ! -e "$marker" ] &&
    { [ -z "$state_version" ] || [ "$state_version" = "$_cc_version" ]; }; then
    ( umask 077; printf '%s\n' "$_cc_version" > "$marker.tmp" && mv -f "$marker.tmp" "$marker" ) 2>/dev/null
    return 0
  fi
  if python3 -c "$shim" cleanup "$d" "$script" "$_cc_version"; then
    ( umask 077; printf '%s\n' "$_cc_version" > "$marker.tmp" && mv -f "$marker.tmp" "$marker" ) 2>/dev/null || {
      echo "claude-copilot: legacy cleanup completed but its retry marker could not be saved" >&2
      _cc_legacy_cleanup_deferred=1
      return 1
    }
    return 0
  fi
  _cc_legacy_cleanup_deferred=1
  return 1
}

# Legacy cleanup runs in the background after a session exits, so it never delays startup.
# Its slow checks run without shim.lock; only the final shim stop takes that lock, without waiting.
_cc_start_legacy_cleanup() {
  local d="$1" script="$2" previous="$3" log="$4" over=""
  [ -f "$d/shim.state" ] && [ ! -L "$d/shim.state" ] && read -r _ _ _ over < "$d/shim.state" 2>/dev/null
  _cc_legacy_cleanup_current "$d" "$over" "$previous" && return 0
  [ -L "$log" ] && return 0
  ( trap '' HUP INT; _cc_legacy_cleanup "$d" "$script" "$over" "$previous" || :; ) </dev/null >>"$log" 2>&1 &
}

_cc_check_update() {
  local script="$1" state="$2" dir latest tmp expected actual
  [ -f "$script" ] && [ ! -L "$script" ] || return 0
  dir="${script%/*}"
  [ "$dir" = "$script" ] && dir="."
  [ -w "$dir" ] || return 0
  latest=$(curl -fsSL -m 5 https://api.github.com/repos/seropian/claude-copilot/releases/latest 2>/dev/null |
    python3 -c 'import json, sys; tag = json.load(sys.stdin).get("tag_name", ""); print(tag[1:] if tag.startswith("v") else tag)' 2>/dev/null) || return 0
  [ -n "$latest" ] || return 0
  python3 -c '
import re, sys
def v(s):
    return tuple(int(x) for x in re.findall(r"\d+", s.split("-")[0].split("+")[0]))
sys.exit(0 if v(sys.argv[1]) > v(sys.argv[2]) else 1)' "$latest" "$_cc_version" 2>/dev/null || return 0
  tmp=$(mktemp "$dir/.claude-copilot-update.XXXXXX") || return 0
  if ! curl -fsSL -m 20 \
    https://github.com/seropian/claude-copilot/releases/latest/download/claude-copilot.sh -o "$tmp" ||
    [ "$(head -c 2 "$tmp")" != "#!" ]; then
    rm -f "$tmp"
    return 0
  fi
  expected=$(curl -fsSL -m 5 \
    https://github.com/seropian/claude-copilot/releases/latest/download/claude-copilot.sh.sha256 2>/dev/null |
    awk 'NR == 1 {print $1}') || { rm -f "$tmp"; return 0; }
  actual=$(python3 -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$tmp" 2>/dev/null) ||
    { rm -f "$tmp"; return 0; }
  if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
    rm -f "$tmp"
    return 0
  fi
  chmod +x "$tmp" || { rm -f "$tmp"; return 0; }
  # launcher already gone (ctrl-c etc): nobody will apply or clean this up
  kill -0 "$3" 2>/dev/null || { rm -f "$tmp"; return 0; }
  printf '%s\n' "$tmp" > "$state" || rm -f "$tmp"
}

_cc_start_update_check() {
  local script="$1" dir state
  [ "${_cc_update_enabled:-0}" = 1 ] || return 0
  [ "${COPILOT_AUTO_UPDATE:-}" != 0 ] || return 0
  dir="${script%/*}"
  [ "$dir" = "$script" ] && dir="."
  [ -w "$dir" ] || return 0
  # leftovers from checks/updaters that never got to clean up (signals, late finishes)
  find "$dir" -maxdepth 1 -name '.claude-copilot-update*' -mmin +60 -exec rm -f {} + 2>/dev/null
  state=$(mktemp "$dir/.claude-copilot-update-state.XXXXXX") || return 0
  rm -f "$state"
  _cc_update_state="$state"
  (_cc_check_update "$script" "$state" "$$" >/dev/null 2>&1 || true) &
}

_cc_schedule_update() {
  local script="$1" state="$2" pid="$$"
  [ -n "$state" ] || return 0
  python3 - "$pid" "$script" "$state" <<'PY' >/dev/null 2>&1 &
import os
import sys
import time

pid, target, state = int(sys.argv[1]), sys.argv[2], sys.argv[3]
while True:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        break
    except PermissionError:
        break
    time.sleep(0.1)
update = ""
deadline = time.time() + 60
while time.time() < deadline:
    try:
        with open(state) as f:
            update = f.read().strip()
        if update:
            break
    except OSError:
        pass
    time.sleep(0.1)
try:
    if update:
        os.replace(update, target)
except OSError:
    try:
        if update:
            os.unlink(update)
    except OSError:
        pass
try:
    os.unlink(state)
except OSError:
    pass
PY
}

claude-copilot() {
  unset _cc_sig
  case "${1:-}" in
    --version|-v|-V)
      printf 'claude-copilot %s\n' "$_cc_version"
      return 0
      ;;
  esac
  _cc_check || return 1
  local sdir="$HOME/.local/share/claude-copilot"
  if [ -n "${COPILOT_STATE_DIR:-}" ] && [ "$COPILOT_STATE_DIR" != "$sdir" ]; then
    echo "claude-copilot: COPILOT_STATE_DIR overrides are not supported; one shared shim uses $sdir. Unset COPILOT_STATE_DIR." >&2
    return 1
  fi
  local _restart=0
  case "${1:-}" in
    --stop-shim|--restart-shim)
      [ "$1" = --restart-shim ] && _restart=1
      local _f="$sdir/shim.state" _p="" _o="" _k="" _i
      ( umask 077; mkdir -p "$sdir" ) || return 1
      _cc_lock_take "$sdir/shim.lock" || { echo "claude-copilot: timed out waiting for shim lock" >&2; return 1; }
      [ -f "$_f" ] && read -r _p _o _k _ < "$_f"
      case "$_p" in ''|*[!0-9]*) ;; *)
        # only kill if the port still answers as our shim (pid may be reused)
        case "$_o" in ''|*[!0-9]*) ;; *)
          if _cc_shim_ok "$_o" "$_k"; then
            kill "$_p" 2>/dev/null
            for _i in $(seq 1 50); do
              _cc_port_busy "$_o" || break
              sleep 0.1
            done
            if _cc_port_busy "$_o"; then
              echo "claude-copilot: shim did not stop; keeping its state" >&2
              _cc_lock_drop
              return 1
            fi
          elif kill -0 "$_p" 2>/dev/null; then
            echo "claude-copilot: recorded shim PID $_p is still alive but cannot be authenticated; keeping its state" >&2
            _cc_lock_drop
            return 1
          fi
          ;;
        esac
        ;;
      esac
      rm -f "$_f"
      rm -rf "$sdir/leases"
      _cc_lock_drop
      [ "$_restart" = 0 ] && echo "claude-copilot: shim stopped" && return 0
      shift
      ;;
  esac
  local sport="${COPILOT_SHIM_PORT:-0}"
  local model="${COPILOT_CLAUDE_MODEL:-}" # empty means use Claude Code's saved /model selection.
  local log="$sdir/claude-copilot.log"
  local spid="" pf="" i rc ms key
  local -a sa=()
  local script="${BASH_SOURCE[0]:-$0}" wrap=0 spare=0 arg
  local _cc_state_dir="$sdir" _cc_lease_file="" _cc_previous_version=""
  case "$script" in /*) ;; *) script="$PWD/${script#./}" ;; esac
  # CLAUDE_CODE_PROCESS_WRAPPER mode: claude spawns "<this script> <cmd> <args...>". Ensure the shim, then run cmd.
  # Claude Code passes the absolute path of its own binary first, and doesn't always forward our env, so detect by that.
  case "${1:-}" in /*) [ -f "$1" ] && [ -x "$1" ] && wrap=1 ;; esac
  if [ "$wrap" = 1 ] && [ "${2:-}" = --bg-spare ]; then
    spare=1
  elif [ "$wrap" = 1 ] && [ "${2:-}" = --bg-pty-host ]; then
    for arg in "$@"; do
      [ "$arg" = --bg-spare ] && spare=1
    done
  fi

  [ "$wrap" = 1 ] || _cc_start_update_check "$script"
  # Shim source (python). Usage: login | serve <port, 0 = any free> <file to write "pid port" to>.
  # The lease directory is shared with the shim so it can reap clients after hard launcher crashes.
  # login: GitHub device-code login, token kept in ~/.local/share/claude-copilot.
  # serve: local Anthropic-style API in front of GitHub Copilot, see README, "How it works".
  local shim='
__CLAUDE_COPILOT_SHIM__
'

  # a hangup/kill/ctrl-c anywhere below tears down what we started (_cc_sig: exit code for the executed wrapper, bash 3.2 loses `return N` from an INT trap)
  [ -n "${ZSH_VERSION:-}" ] && setopt local_options no_monitor no_notify 2>/dev/null
  trap '_cc_cleanup "$spid" "$pf"; trap - HUP TERM INT; _cc_sig=129; return 129' HUP
  trap '_cc_cleanup "$spid" "$pf"; trap - HUP TERM INT; _cc_sig=143; return 143' TERM
  trap '_cc_cleanup "$spid" "$pf"; trap - HUP TERM INT; _cc_sig=130; return 130' INT

  # 1) login: no-op when a token is already stored
  python3 -c "$shim" login || { _cc_fail; return; }

  # 2) shim: one shared, long-lived instance per user. It outlives this launcher on purpose: claude sessions
  # (backgrounded, resumed, attached later) keep the base URL + key they started with, so the shim must stay up.
  # State file "pid port key version" lets any later run reuse it, or restart it on the same port and key.
  case "$sport" in ''|*[!0-9]*) echo "claude-copilot: COPILOT_SHIM_PORT must be a port number, got '$sport'" >&2; _cc_fail; return ;; esac
  ( umask 077; mkdir -p "$sdir" ) 2>/dev/null
  chmod 700 "$sdir" 2>/dev/null
  if [ -L "$log" ]; then
    echo "claude-copilot: refusing to write to $log, it is a symlink" >&2; _cc_fail; return
  fi
  local sf opid="" oport="" okey="" over="" want="$sport" healthy=0
  sf="$sdir/shim.state"
  _cc_lease_file=""
  [ "$wrap" = 1 ] || _cc_announce_update "$sdir/last-version"
  _cc_lock_take "$sdir/shim.lock" || { echo "claude-copilot: timed out waiting for $sdir/shim.lock (if no other claude-copilot is starting, rm -rf it)" >&2; _cc_fail; return; }
  [ -f "$sf" ] && [ ! -L "$sf" ] && read -r opid oport okey over < "$sf" 2>/dev/null
  case "$oport" in ''|*[!0-9]*) oport=""; okey="" ;; esac
  _cc_lease_reap "$sdir/leases"
  _cc_lease_reap "$sdir/spares"
  [ -n "$oport" ] && [ -n "$okey" ] && _cc_shim_ok "$oport" "$okey" && healthy=1
  if [ "$healthy" = 1 ] && [ "$want" != 0 ] && [ "$want" != "$oport" ]; then
    echo "claude-copilot: shared shim already uses port $oport; unset COPILOT_SHIM_PORT or stop the shim before changing ports" >&2
    _cc_fail; return
  fi
  if [ "$healthy" = 0 ]; then
    case "$opid" in ''|*[!0-9]*) ;; *)
      if kill -0 "$opid" 2>/dev/null; then
        echo "claude-copilot: recorded shim PID $opid is still alive but unhealthy; refusing to start a second shim" >&2
        _cc_fail; return
      fi
      ;;
    esac
  fi
  # A healthy shim can outlive the launcher that started it. Reuse it across
  # launcher versions so another client is never interrupted by an update.
  if [ "$healthy" = 1 ] && [ "$over" != "$_cc_version" ]; then
    if _cc_lease_any "$sdir/leases"; then
      # Keep an active old shim alive; its existing clients may be streaming.
      printf 'header = "x-api-key: %s"\n' "$okey" |
        curl -sf -m 2 -X POST -K - "http://127.0.0.1:$oport/_shim/retire" >/dev/null 2>&1 || true
    elif [ "$wrap" = 0 ]; then
      echo "claude-copilot: keeping the older shim; legacy cleanup retries in the background after this session exits" >&2
    else
      echo "claude-copilot: keeping the older shim until a normal launch can verify it is idle" >&2
    fi
  fi
  if [ "$healthy" = 1 ]; then
    sport="$oport"; key="$okey"
  else
    key=""
    if [ "$want" = 0 ] && [ -n "$oport" ] && ! _cc_port_busy "$oport"; then
      want="$oport"; key="$okey"
    elif [ "$want" = 0 ] && [ -n "$oport" ]; then
      echo "claude-copilot: previous shim port $oport is taken by another process, using a new port. Sessions started earlier can't reconnect; restart them." >&2
    elif [ "$want" != 0 ] && _cc_port_busy "$want"; then
      echo "claude-copilot: port $want busy, unset COPILOT_SHIM_PORT to pick a free one" >&2
      _cc_fail; return
    fi
    [ -n "$key" ] || key=$(python3 -c 'import secrets; print(secrets.token_hex(24))') || { _cc_fail; return; }
    pf=$(mktemp "$sdir/start.XXXXXX") || { _cc_fail; return; }
    ( umask 077; COPILOT_SHIM_KEY="$key" COPILOT_SHIM_VERSION="$_cc_version" COPILOT_SHIM_STATE_FILE="$sf" COPILOT_SHIM_LEASE_DIR="$sdir/leases" nohup python3 -c "$shim" serve "$want" "$pf" >>"$log" 2>&1 & echo $! >"$pf.pid" )
    sport=""
    for i in $(seq 1 100); do
      read -r spid sport < "$pf" 2>/dev/null
      [ -n "$sport" ] && break
      sleep 0.1
    done
    if [ -z "$sport" ]; then
      _cc_cleanup "$spid" "$pf"; spid=""; pf=""
      # lost a startup race with another launcher? use only a current-version shim
      read -r opid oport okey over < "$sf" 2>/dev/null
      if [ "$over" = "$_cc_version" ] && [ -n "$oport" ] && [ -n "$okey" ] && _cc_shim_ok "$oport" "$okey"; then
        sport="$oport"; key="$okey"
      else
        echo "claude-copilot: shim didn't start, see $log" >&2
        tail -n 5 "$log" 2>/dev/null | sed 's/^/  /' >&2
        _cc_fail; return
      fi
    else
      ( umask 077; printf '%s %s %s %s\n' "$spid" "$sport" "$key" "$_cc_version" > "$sf.tmp" && mv -f "$sf.tmp" "$sf" )
      rm -f "$pf" "$pf.pid" "$pf.tmp"
      spid=""; pf=""
    fi
  fi
  _cc_lease_add "$sdir/leases" "$spare" || { echo "claude-copilot: could not register shim client" >&2; _cc_lock_drop; _cc_fail; return; }

  _cc_lock_drop

  # 3) claude, with env scoped to this one command (shell env stays clean).
  # Load the picker from disk and always pass connection settings, even on the first launch.
  ms=""
  if [ "$wrap" = 0 ]; then
      if ! _cc_picker_ready "$sdir/model-picker.json"; then
        echo "claude-copilot: fetching the required model list (5s timeout)" >&2
        if ! _cc_refresh_picker "$sdir" "$sport" "$key" 5; then
          echo "claude-copilot: complete model list unavailable; Claude was not started. Retry when Copilot is reachable." >&2
          _cc_release "$sdir"
          _cc_fail; return
        fi
      fi
      ms=$(CC_SETTINGS_DIR="$sdir" CC_SETTINGS_BASE="http://127.0.0.1:$sport" CC_SETTINGS_KEY="$key" \
        CC_SETTINGS_MODEL="$model" \
        CC_SETTINGS_SONNET="${COPILOT_SONNET_MODEL:-claude-sonnet-5.5}" \
        CC_SETTINGS_OPUS="${COPILOT_OPUS_MODEL:-claude-opus-5.5}" \
        CC_SETTINGS_FABLE="${COPILOT_FABLE_MODEL:-claude-opus-5.5}" \
        CC_SETTINGS_HAIKU="${COPILOT_HAIKU_MODEL:-claude-haiku-4.5}" \
        python3 -c 'import hashlib, json, os, sys, tempfile
cache = os.path.join(os.environ["CC_SETTINGS_DIR"], "model-picker.json")
with open(cache) as f: cached = json.load(f)
s = {"modelPicker": cached["modelPicker"]}
e=s.setdefault("env", {}); e.update({
          "ANTHROPIC_BASE_URL": os.environ["CC_SETTINGS_BASE"], "ANTHROPIC_AUTH_TOKEN": os.environ["CC_SETTINGS_KEY"],
          "ANTHROPIC_DEFAULT_SONNET_MODEL": os.environ["CC_SETTINGS_SONNET"], "ANTHROPIC_DEFAULT_OPUS_MODEL": os.environ["CC_SETTINGS_OPUS"],
          "ANTHROPIC_DEFAULT_FABLE_MODEL": os.environ["CC_SETTINGS_FABLE"], "ANTHROPIC_DEFAULT_HAIKU_MODEL": os.environ["CC_SETTINGS_HAIKU"],
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1", "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
          "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1"});
if os.environ["CC_SETTINGS_MODEL"]: e["ANTHROPIC_MODEL"] = os.environ["CC_SETTINGS_MODEL"]
else: e.pop("ANTHROPIC_MODEL", None)
d=json.dumps(s, separators=(",", ":"))
p=os.path.join(os.environ["CC_SETTINGS_DIR"], "settings-" + hashlib.sha256(d.encode()).hexdigest()[:16] + ".json")
fd, tmp = tempfile.mkstemp(prefix="settings-", suffix=".tmp", dir=os.environ["CC_SETTINGS_DIR"])
with os.fdopen(fd, "w") as f: f.write(d)
os.replace(tmp, p); print(p)') || {
        echo "claude-copilot: could not write complete session settings; Claude was not started" >&2
        _cc_release "$sdir"
        _cc_fail; return
      }
      [ -n "$ms" ] && sa=(--settings "$ms")
      _cc_start_picker_refresh "$sdir" "$sport" "$key" "$log"
  fi
  # INT is a no-op here (claude resets it to default) so claude's exit code survives ctrl-c.
  trap : INT
  ANTHROPIC_BASE_URL="http://127.0.0.1:$sport" \
  ANTHROPIC_AUTH_TOKEN="$key" \
  ANTHROPIC_MODEL="$model" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="${COPILOT_SONNET_MODEL:-claude-sonnet-5.5}" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="${COPILOT_OPUS_MODEL:-claude-opus-5.5}" \
  ANTHROPIC_DEFAULT_FABLE_MODEL="${COPILOT_FABLE_MODEL:-claude-opus-5.5}" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="${COPILOT_HAIKU_MODEL:-claude-haiku-4.5}" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  CLAUDE_CODE_AUTO_MODE_SERVER=0 \
  CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1 \
  CLAUDE_CODE_PROCESS_WRAPPER="$script" \
  CLAUDE_COPILOT_WRAP=1 \
  _cc_run "$@"
  rc=$?

  # 4) release this client; the last client stops the shared shim.
  _cc_release "$sdir"
  if [ "$wrap" = 0 ]; then
    ( find "$sdir" -maxdepth 1 -name 'settings-*.json' -mtime +7 ! -path "$ms" -exec rm -f {} + 2>/dev/null ) </dev/null >>"$log" 2>&1 &
  fi
  [ "$wrap" = 0 ] && _cc_start_legacy_cleanup "$sdir" "$script" "$_cc_previous_version" "$log"
  _cc_schedule_update "$script" "$_cc_update_state"
  _cc_update_state=""
  trap - HUP TERM INT
  return $rc
}

# executed (not sourced): run it. zsh: sourced context ends in ":file".
# bash: sourced when $BASH_SOURCE differs from $0.
_cc_sourced=0
if [ -n "${ZSH_VERSION:-}" ]; then
  case "${ZSH_EVAL_CONTEXT:-}" in *:file*) _cc_sourced=1 ;; esac
elif [ -n "${BASH_VERSION:-}" ]; then
  [ "${BASH_SOURCE[0]}" != "$0" ] && _cc_sourced=1
fi
if [ "$_cc_sourced" = 0 ]; then
  _cc_update_enabled=1
  claude-copilot "$@"
  _cc_rc=$?
  exit "${_cc_sig:-$_cc_rc}"
fi
unset _cc_sourced
